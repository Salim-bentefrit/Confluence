function job
{
	commentaire "Positionnement dans le repertoire ${REP_TRANS_IN}"
	cd ${REP_TRANS_IN}
	typeset -i COMPTEUR=0

	if [ "`ls -tr ${FICHIER} 2>/dev/null | wc -l`" -ge 1 ]
	then
		for FILE in `ls -tr ${FICHIER}`
		do
			# Test si fichier non vide
			if [ -s ${FILE} ]
			then
				cp ${FILE} ${REP_TRAIT_IN}/
				RETOUR=$?

				if [ $RETOUR -ne 0 ]
				then
					commentaire "Erreur ${RETOUR} lors de la copie de ${FILE} dans ${REP_TRAIT_IN}"
					return 23
				else
					commentaire "Copie de ${FILE} dans ${REP_TRAIT_IN}"

					gzip ${REP_TRANS_IN}/${FILE}
					mv ${REP_TRANS_IN}/${FILE}.gz ${REP_ARC_IN}/
					commentaire "Archivage de ${FILE}.gz dans ${REP_ARC_IN}"

					break
				fi
			else
				gzip ${REP_TRANS_IN}/${FILE}
				mv ${REP_TRANS_IN}/${FILE}.gz ${REP_ARC_IN}/
				break
			fi
		done
	else
		commentaire "Il y a aucun fichier a traiter"
	fi

	return $RETOUR
}